{
  "name": "@omni-model/node",
  "version": "0.1.0",
  "description": "Node.js server for omni-model: loads configuration and serves the proxy in a container.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "omni-model": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@omni-model/admin": "workspace:*",
    "@omni-model/core": "workspace:*",
    "@omni-model/postgres": "workspace:*",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "pg": "^8.22.0"
  }
}
