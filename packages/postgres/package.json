{
  "name": "@omni-model/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL backend for omni-model: schema migrations, rate-limit counters, and attestation state.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema:generate": "drizzle-kit generate --name baseline"
  },
  "dependencies": {
    "@omni-model/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.10"
  }
}
