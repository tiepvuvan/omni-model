# Firebase client identifiers. These values are embedded in client apps and are not server secrets.
FIREBASE_API_KEY=your-firebase-client-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PROJECT_NUMBER=your-numeric-project-number
FIREBASE_APP_ID=your-firebase-app-id

# Preferred Firebase Auth fixture: exchanges a custom token without enabling a sign-in provider.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_AUTH_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Registered App Check debug secret. Prefer a mode-0600 file over a direct environment value.
FIREBASE_APPCHECK_DEBUG_TOKEN_FILE=/tmp/omni-firebase-app-check-debug-token
# FIREBASE_APPCHECK_DEBUG_TOKEN=registered-debug-token

# Optional replay-protection check. ADC must have roles/firebaseappcheck.tokenVerifier.
# FIREBASE_APPCHECK_TEST_CONSUME=true

# Optional strict gate. Missing inputs become failures instead of skipped checks.
# OMNI_E2E_REQUIRE_FIREBASE=auth,app-check,combined,replay-protection
