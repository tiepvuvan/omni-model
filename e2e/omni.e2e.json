{
  "version": 1,
  "server": {
    "logLevel": "warn"
  },
  "storage": {
    "type": "memory"
  },
  "security": {
    "userAuth": {
      "type": "jwt",
      "secret": "omni-e2e-shared-secret-not-a-real-credential",
      "algorithms": ["HS256"]
    }
  },
  "rateLimits": [
    {
      "name": "per-user-tokens",
      "tokens": {
        "limit": 200000,
        "window": "1h"
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "id": "openrouter",
        "when": "true",
        "target": {
          "type": "openai-compatible",
          "baseUrl": "https://openrouter.ai/api/v1",
          "apiKey": "${OPENROUTER_API_KEY}",
          "headers": {
            "HTTP-Referer": "https://github.com/tiepvuvan/omni-model",
            "X-Title": "omni-model e2e"
          }
        }
      }
    ]
  }
}
