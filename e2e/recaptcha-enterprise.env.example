# Backend assessment authentication. Configure exactly one credential method.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# RECAPTCHA_ENTERPRISE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# RECAPTCHA_ENTERPRISE_API_KEY=restricted-server-api-key

RECAPTCHA_ENTERPRISE_PROJECT_ID=your-gcp-project-id
RECAPTCHA_ENTERPRISE_ACTION=LOGIN
# Live integration tests default to 0 so a new/test key's low-confidence score is not flaky.
RECAPTCHA_ENTERPRISE_MIN_SCORE=0

# Web: generate a one-time token with `pnpm recaptcha:web-token`.
RECAPTCHA_ENTERPRISE_WEB_SITE_KEY=your-web-site-key
RECAPTCHA_ENTERPRISE_WEB_HOSTNAME=localhost
RECAPTCHA_ENTERPRISE_WEB_TOKEN_FILE=/tmp/omni-recaptcha-enterprise-web-token

# Android: write a fresh mobile-SDK token to the file immediately before the test.
RECAPTCHA_ENTERPRISE_ANDROID_SITE_KEY=your-android-site-key
RECAPTCHA_ENTERPRISE_ANDROID_PACKAGE_NAME=com.example.omni
RECAPTCHA_ENTERPRISE_ANDROID_TOKEN_FILE=/tmp/omni-recaptcha-enterprise-android-token

# iOS: write a fresh mobile-SDK token to the file immediately before the test.
RECAPTCHA_ENTERPRISE_IOS_SITE_KEY=your-ios-site-key
RECAPTCHA_ENTERPRISE_IOS_BUNDLE_ID=com.example.omni
RECAPTCHA_ENTERPRISE_IOS_TOKEN_FILE=/tmp/omni-recaptcha-enterprise-ios-token

# Optional strict gate for an on-device CI job. Missing inputs become failures, not skips.
# OMNI_E2E_REQUIRE_RECAPTCHA_PLATFORMS=web,android,ios
